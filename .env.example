# ==========================================
# PORTFOLIO ENVIRONMENT VARIABLES (TEMPLATE)
# ==========================================
# Copy this file to .env for local development.
# In production on Vercel, set these in Project Settings -> Environment Variables.
# NEVER commit your actual .env file to GitHub!
# ==========================================

# 1. Server-Side Admin Authentication Secrets (CRITICAL: Do NOT prefix with VITE_)
ADMIN_EMAIL=kundan@portfolio.local
ADMIN_PASSWORD=your_strong_admin_password_here
JWT_SECRET=replace_with_a_cryptographically_random_jwt_secret_key_at_least_32_chars
SESSION_SECRET=replace_with_a_secure_session_secret_key

# 2. Database Connection (Optional - defaults to persistent JSON store in .data/db.json)
# DATABASE_URL=mongodb+srv://... or postgresql://...

# 3. Public Frontend Configuration (Contact form via EmailJS)
VITE_SERVICE_ID=your_emailjs_service_id
VITE_TEMPLATE_ID=your_emailjs_template_id
VITE_PUBLIC_KEY=your_emailjs_public_key

# 4. Optional Firebase Configuration (Public client keys for optional Firebase features)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# 5. Optional Google Analytics 4 (GA4) Tracking (e.g. G-XXXXXXXXXX)
# Can also be entered dynamically in the Admin Dashboard!
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
